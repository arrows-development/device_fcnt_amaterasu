type fcnt_vl53l1_daemon_service, domain, mlstrustedsubject;
type fcnt_vl53l1_daemon_service_exec, exec_type, vendor_file_type, file_type;
type fcnt_stmvl53l1_ranging_dev, dev_type, fs_type, mlstrustedobject;

init_daemon_domain(fcnt_vl53l1_daemon_service)

allow fcnt_vl53l1_daemon_service self:{ netlink_socket netlink_iscsi_socket } create_socket_perms_no_ioctl;
allow fcnt_vl53l1_daemon_service sysfs:file r_file_perms;
allow fcnt_vl53l1_daemon_service mnt_vendor_file:file rw_file_perms;
allow fcnt_vl53l1_daemon_service mnt_vendor_file:dir create_dir_perms;
allow fcnt_vl53l1_daemon_service fcnt_stmvl53l1_ranging_dev:chr_file rw_file_perms;

allow vendor_init fcnt_stmvl53l1_ranging_dev:chr_file setattr;
